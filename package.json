{
  "name": "jupyter-aiterminal",
  "version": "0.3.2",
  "description": "AI Terminal (Agent Workspace) for JupyterLab.",
  "keywords": [
    "jupyter",
    "jupyterlab",
    "jupyterlab-extension",
    "agent"
  ],
  "homepage": "https://github.com/wangyusheng1985/jupyter-plugin-aiterminal",
  "bugs": {
    "url": "https://github.com/wangyusheng1985/jupyter-plugin-aiterminal/issues"
  },
  "license": "BSD-3-Clause",
  "author": "AI Terminal contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/wangyusheng1985/jupyter-plugin-aiterminal.git"
  },
  "files": [
    "lib/**/*.{d.ts,js,js.map}",
    "style/**/*.{css,js}",
    "schema/*.json",
    "src/**/*.ts"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "style": "style/index.css",
  "styleModule": "style/index.js",
  "scripts": {
    "build": "jlpm build:lib && jlpm build:labextension:dev",
    "build:prod": "jlpm clean && jlpm build:lib:prod && jlpm build:labextension",
    "build:labextension": "jupyter labextension build .",
    "build:labextension:dev": "jupyter labextension build --development=True .",
    "build:lib": "tsc --sourceMap",
    "build:lib:prod": "tsc",
    "clean": "jlpm clean:lib",
    "clean:lib": "rimraf lib tsconfig.tsbuildinfo",
    "clean:labextension": "rimraf jupyter_aiterminal/labextension jupyter_aiterminal/_version.py",
    "clean:all": "jlpm clean:lib && jlpm clean:labextension",
    "eslint": "eslint src --max-warnings=0",
    "install:extension": "jlpm build",
    "lint": "jlpm eslint && jlpm prettier:check",
    "prettier:check": "prettier --check \"{src,style,schema}/**/*.{ts,css,js,json}\" \"*.{json,md}\"",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit",
    "watch": "run-p watch:src watch:labextension",
    "watch:src": "tsc -w --sourceMap",
    "watch:labextension": "jupyter labextension watch ."
  },
  "dependencies": {
    "@jupyterlab/application": "~4.5.0",
    "@jupyterlab/apputils": "~4.6.0",
    "@jupyterlab/cells": "~4.5.0",
    "@jupyterlab/coreutils": "~6.5.0",
    "@jupyterlab/docmanager": "~4.5.0",
    "@jupyterlab/docregistry": "~4.5.0",
    "@jupyterlab/filebrowser": "~4.5.0",
    "@jupyterlab/launcher": "~4.5.0",
    "@jupyterlab/rendermime": "~4.5.0",
    "@jupyterlab/services": "~7.5.0",
    "@jupyterlab/translation": "~4.5.0",
    "@jupyterlab/ui-components": "~4.5.0",
    "@lumino/widgets": "^2.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@jupyter/eslint-plugin": "^1.1.0",
    "@jupyterlab/builder": "~4.5.0",
    "@jupyterlab/testutils": "~4.5.0",
    "@lumino/commands": "^2.3.2",
    "@types/jest": "^29.5.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-react": "^7.37.0",
    "globals": "^15.0.0",
    "jest": "^29.7.0",
    "npm-run-all2": "^7.0.0",
    "prettier": "^3.0.0",
    "rimraf": "^5.0.0",
    "typescript": "~5.8.0",
    "typescript-eslint": "^8.0.0"
  },
  "sideEffects": [
    "style/*.css",
    "style/index.js"
  ],
  "jupyterlab": {
    "discovery": {
      "server": {
        "managers": [
          "pip"
        ],
        "base": {
          "name": "jupyter_aiterminal"
        }
      }
    },
    "extension": true,
    "schemaDir": "schema",
    "outputDir": "jupyter_aiterminal/labextension",
    "sharedPackages": {
      "@jupyterlab/application": {
        "bundled": false,
        "singleton": true
      },
      "@jupyterlab/apputils": {
        "bundled": false,
        "singleton": true
      },
      "@jupyterlab/cells": {
        "bundled": false,
        "singleton": true
      },
      "@jupyterlab/docmanager": {
        "bundled": false,
        "singleton": true
      },
      "@jupyterlab/docregistry": {
        "bundled": false,
        "singleton": true
      },
      "@jupyterlab/filebrowser": {
        "bundled": false,
        "singleton": true
      },
      "@jupyterlab/rendermime": {
        "bundled": false,
        "singleton": true
      },
      "@jupyterlab/ui-components": {
        "bundled": false,
        "singleton": true
      },
      "react": {
        "bundled": false,
        "singleton": true
      }
    }
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "none",
    "arrowParens": "avoid",
    "endOfLine": "auto"
  }
}
